# =========================================================
# LEXICORE SUITE — ENVIRONMENT CONFIGURATION
# =========================================================

# Database Connection (PostgreSQL with pgvector on Supabase, Neon, or Local)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/lexicore_db?schema=public"

# Google Gemini API Key for Multimodal Document Verification
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Cloudflare R2 / AWS S3 S3-Compatible Storage for Secure PDF Documents
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="lexicore-documents"
R2_PUBLIC_DOMAIN="https://documents.yourfirm.com"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
